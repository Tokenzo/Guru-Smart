# ============================================================
# GURU SMART — AI School Quality & Learning Management Platform
# Local environment configuration (Freebuff)
# ============================================================

# GEMINI_API_KEY: Required to activate server-side Gemini AI analysis.
# Isi dengan API key asli Anda (jangan gunakan key palsu).
# Biarkan kosong ("") untuk menjalankan aplikasi dengan mesin fallback
# Analyst Engine bawaan — seluruh fitur tetap berfungsi tanpa kunci.
GEMINI_API_KEY=""

# APP_URL: URL tempat aplikasi ini di-hosting.
# Didokumentasikan di .env.example; saat ini tidak dipakai oleh kode.
APP_URL=""